[Desktop Entry]
Type=Service
MimeType=inode/directory;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Protocols=file
X-KDE-RequiredNumberOfUrls=1
X-KDE-Submenu=USB stick
X-KDE-Submenu[de]=USB-Stick
Actions=image;format

[Desktop Action image]
Name=Write image…
Name[de]=Image schreiben…
Icon=drive-removable-media
Exec=vela drives image %f

[Desktop Action format]
Name=Format…
Name[de]=Formatieren…
Icon=edit-clear-all
Exec=vela drives format %f
